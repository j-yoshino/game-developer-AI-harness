{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "model": "sonnet",
  "skillOverrides": {
    "superpowers:writing-plans": "off",
    "superpowers:executing-plans": "off",
    "superpowers:subagent-driven-development": "off",
    "writing-plans": "off",
    "executing-plans": "off",
    "subagent-driven-development": "off"
  },
  "enableWorkflows": true,
  "workflowKeywordTriggerEnabled": true,
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true,
    "superpowers@superpowers-dev": true
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "directory",
        "path": "vendor/superpowers"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "directory",
        "path": "vendor/i-have-adhd"
      }
    }
  },
  "language": "japanese",
  "effortLevel": "medium",
  "advisorModel": "opus",
  "teammateMode": "auto"
}
