{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "model": "sonnet",
  "enableWorkflows": true,
  "workflowKeywordTriggerEnabled": true,
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true,
    "superpowers@superpowers-dev": true,
    "unity@unity-agent-plugin": true,
    "unreal-engine-skills-for-claude-code@game-developer-ai-harness": true
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": {
        "source": "directory",
        "path": "vendor/superpowers"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "directory",
        "path": "vendor/i-have-adhd"
      }
    },
    "unity-agent-plugin": {
      "source": {
        "source": "directory",
        "path": "vendor/unity-agent-plugin"
      }
    },
    "game-developer-ai-harness": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "language": "japanese",
  "effortLevel": "medium",
  "advisorModel": "opus",
  "teammateMode": "auto",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/window-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
