{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/window-reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "superpowers-dev": {
      "source": { "source": "github", "repo": "obra/superpowers" }
    },
    "unity-agent-plugin": {
      "source": { "source": "github", "repo": "Unity-Technologies/unity-agent-plugin" }
    },
    "i-have-adhd": {
      "source": { "source": "github", "repo": "ayghri/i-have-adhd" }
    },
    "game-developer-ai-harness": {
      "source": { "source": "directory", "path": "." }
    }
  },
  "enabledPlugins": {
    "superpowers@superpowers-dev": true,
    "unity@unity-agent-plugin": true,
    "i-have-adhd@i-have-adhd": true,
    "unreal-engine-skills-for-claude-code@game-developer-ai-harness": true
  }
}
